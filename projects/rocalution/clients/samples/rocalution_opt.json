    "cycle": ["V"],
    "pre_smooth_iter": [1, 2],
    "post_smooth_iter": [1, 2],
    "coarsest_level": [20],
    "host_levels": 2,

    "smoother": ["Jacobi"],
    "coarse_solver": ["LU"],

    "abs_tol": 1e-8,
    "rel_tol": 1e-8,
    "div_tol": 1e8,
    "max_iter": 100,

    "repeats": 5
}
